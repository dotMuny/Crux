<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crux · {{ project }} · {{ scan_id }}</title>
{# El sistema de diseño va EN LÍNEA: un informe que pidiese una hoja de estilos
   remota contradiría todo lo que esta herramienta promete. #}
<style>{{ fuentes|safe }}</style>
<style>{{ tokens|safe }}</style>
<style>
*{box-sizing:border-box}
body{
  margin:0;background:var(--cx-bg);color:var(--cx-fg);
  font:400 var(--cx-text-base)/1.6 var(--cx-sans);
  -webkit-font-smoothing:antialiased
}
.sheet{max-width:1020px;margin:0 auto;padding:var(--cx-space-6) max(20px,4vw)}
.lbl{font:700 var(--cx-text-sm) var(--cx-sans);color:var(--cx-fg-dim)}
header.head{
  display:flex;flex-wrap:wrap;gap:var(--cx-space-3) var(--cx-space-5);
  align-items:baseline;padding-bottom:var(--cx-space-4);
  border-bottom:var(--cx-rule) solid var(--cx-border-strong)
}
.brand{display:inline-flex;align-items:center;gap:9px;font:700 var(--cx-text-lg) var(--cx-sans);letter-spacing:.14em}
.brand svg{width:22px;height:22px}
.ctx{font:400 var(--cx-text-sm) var(--cx-mono);color:var(--cx-fg-dim)}
.ctx b{color:var(--cx-fg);font-weight:400}
/* Verde, no magenta: esto no se puede pulsar, es una constatación. */
.egress{
  margin-left:auto;font:700 var(--cx-text-xs) var(--cx-sans);color:var(--cx-ok);
  border:1.5px solid var(--cx-ok-dim);padding:5px 11px;border-radius:var(--cx-radius)
}
h1{margin:var(--cx-space-5) 0 var(--cx-space-3);font:700 var(--cx-text-2xl)/1.15 var(--cx-sans);text-wrap:balance}
.lede{margin:0 0 var(--cx-space-5);color:var(--cx-fg-dim);max-width:68ch;font-size:var(--cx-text-md)}
.lede b{color:var(--cx-crit-fg);font-weight:700}

.band{display:flex;flex-direction:column;gap:var(--cx-space-2);margin-bottom:var(--cx-space-3)}
.track{display:flex;gap:2px;height:10px;overflow:hidden;background:var(--cx-bg)}
.legend{display:flex;flex-wrap:wrap;align-items:center;font:400 var(--cx-text-sm) var(--cx-sans);color:var(--cx-fg-dim)}
/* Márgenes y no `gap`: WeasyPrint no separa con `gap` los hijos de un
   flex en línea, y en el PDF la leyenda salía pegada. */
.legend span{display:inline-flex;align-items:center;margin-right:var(--cx-space-4)}
.legend .cx-fig,.badge .cx-fig{margin-right:7px}
.legend b{margin-left:6px}
.legend b{color:var(--cx-fg);font-weight:400;font-variant-numeric:tabular-nums}
.stats{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
  gap:var(--cx-rule);background:var(--cx-border);
  border:var(--cx-rule) solid var(--cx-border);margin-bottom:var(--cx-space-6)
}
.stats div{background:var(--cx-surface);padding:var(--cx-space-3) var(--cx-space-3);min-width:0}
.stats dd{margin:5px 0 0;font:400 var(--cx-text-xl)/1 var(--cx-mono);font-variant-numeric:tabular-nums}
.stats dd small{font:400 var(--cx-text-sm) var(--cx-sans);color:var(--cx-fg-dim)}

h2.sec{
  display:flex;align-items:center;gap:10px;
  margin:var(--cx-space-6) 0 var(--cx-space-3);font:700 var(--cx-text-lg) var(--cx-sans);
  border-bottom:var(--cx-rule) solid var(--cx-border-strong);padding-bottom:var(--cx-space-2)
}
h2.sec small{font:400 var(--cx-text-sm) var(--cx-sans);color:var(--cx-fg-dim)}
article.f{
  border:var(--cx-rule) solid var(--cx-border);border-radius:var(--cx-radius);
  background:var(--cx-surface);margin-bottom:var(--cx-space-3);break-inside:avoid
}
article.f > .top{padding:var(--cx-space-3) var(--cx-space-4)}
.tags{display:flex;gap:var(--cx-space-2);flex-wrap:wrap;align-items:center;margin-bottom:var(--cx-space-2)}
.badge{display:inline-flex;align-items:center;font:700 var(--cx-text-sm) var(--cx-sans)}
.chip{
  font:400 var(--cx-text-xs) var(--cx-mono);color:var(--cx-fg-dim);
  border:var(--cx-rule) solid var(--cx-border-strong);border-radius:var(--cx-radius);padding:2px 8px
}
.chip.nuevo{color:var(--cx-high-fg);border-color:var(--cx-high)}
article.f h3{margin:0 0 var(--cx-space-2);font:700 var(--cx-text-lg)/1.28 var(--cx-sans);text-wrap:balance}
.url{
  display:block;font:400 var(--cx-text-xs)/1.5 var(--cx-mono);color:var(--cx-fg);
  overflow-wrap:anywhere;margin-bottom:var(--cx-space-3)
}
article.f p{margin:0 0 var(--cx-space-3);line-height:1.65;max-width:72ch;color:var(--cx-fg-body)}
.fix::before{content:"Cómo se corrige. ";font-weight:700;color:var(--cx-fg)}
details{border-top:var(--cx-rule) solid var(--cx-border)}
details summary{
  padding:var(--cx-space-2) var(--cx-space-4);cursor:pointer;
  font:700 var(--cx-text-sm) var(--cx-sans);color:var(--cx-fg-dim)
}
details summary:hover{color:var(--cx-fg)}
pre{
  margin:0;padding:var(--cx-space-3) var(--cx-space-4);background:var(--cx-surface-3);
  overflow-x:auto;font:400 var(--cx-text-xs)/1.7 var(--cx-pre);color:var(--cx-code);white-space:pre-wrap;
  word-break:break-word;border-top:var(--cx-rule) solid var(--cx-border)
}
pre .hk{color:var(--cx-low)}
footer{
  margin-top:var(--cx-space-6);padding-top:var(--cx-space-4);
  border-top:var(--cx-rule) solid var(--cx-border);
  font:400 var(--cx-text-xs)/1.8 var(--cx-mono);color:var(--cx-fg-faint)
}
footer b{color:var(--cx-fg-dim);font-weight:400}

/* En papel: superficie clara, nada de interacción, y cada hallazgo entero. */
@media print{
  .sheet{max-width:none;padding:0}
  /* En papel las cifras van en una fila de anchos iguales: WeasyPrint no
     resuelve `repeat(auto-fit, minmax())` y las apilaba de dos en dos. */
  .stats{display:flex}
  .stats div{flex:1 1 0;border-right:var(--cx-rule) solid var(--cx-border)}
  .stats div:last-child{border-right:0}
  header.head{align-items:center}
  /* WeasyPrint dibuja dos veces el borde de una caja con esquinas
     redondeadas cuando es un hijo de flex: en papel van rectas. */
  .chip,.egress,article.f{border-radius:0}
  .egress,.chip{border:0;padding:0}
  .chip{margin-right:10px}
  details{border-top:var(--cx-rule) solid var(--cx-border)}
  details summary{display:none}
  details[open] pre, details pre{display:block}
  article.f{page-break-inside:avoid}
  a{color:inherit;text-decoration:none}
}
@page{size:A4;margin:16mm 14mm 18mm}
</style>
</head>
<body>
<div class="sheet">
  <header class="head">
    <span class="brand"><svg aria-hidden="true" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="13" cy="13" r="8"/><path d="M13 1v8M13 17v8M1 13h8M17 13h8"/></svg>CRUX</span>
    <span class="ctx"><b>{{ project }}</b>, escaneo {{ scan_id }}, perfil {{ profile }}, {{ started }}</span>
    <span class="egress">{{ egress }}</span>
  </header>

  <h1>{{ headline }}</h1>
  <p class="lede">{{ lede|safe }}</p>

  <div class="band">
    <div class="track">
      {%- for level, count in severity_counts.items() if count %}
      <span style="flex:{{ count }};background:var(--cx-{{ level_token[level] }})"></span>
      {%- endfor %}
    </div>
    <div class="legend">
      {%- for level, count in severity_counts.items() %}
      <span><i class="cx-fig sev-{{ level }}"></i>{{ level_label[level] }} <b>{{ count }}</b></span>
      {%- endfor %}
    </div>
  </div>

  <dl class="stats">
    {% if kind == "code" %}
    <div><dt class="lbl">Herramientas</dt><dd>{{ tools.split(', ')|length }}</dd></div>
    {% else %}
    <div><dt class="lbl">Objetivos</dt><dd>{{ targets_count }}</dd></div>
    <div><dt class="lbl">URLs vivas</dt><dd>{{ alive }}<small>/{{ probed }}</small></dd></div>
    {% endif %}
    <div><dt class="lbl">Hallazgos</dt><dd>{{ findings|length }}</dd></div>
    <div><dt class="lbl">Nuevos</dt><dd>{{ new }}</dd></div>
    <div><dt class="lbl">Corregidos</dt><dd>{{ fixed }}</dd></div>
    <div><dt class="lbl">Duración</dt><dd>{{ duration }}</dd></div>
  </dl>

  {% for level in order %}
    {% set group = findings|selectattr("severity_label", "equalto", level)|list %}
    {% if group %}
    <h2 class="sec sev-{{ level }}"><i class="cx-fig sev-{{ level }}"></i>{{ level_label[level] }} <small>{{ group|length }}</small></h2>
      {% for f in group %}
      <article class="f sev-{{ level }}">
        <div class="top">
          <div class="tags">
            <span class="badge"><i class="cx-fig sev-{{ level }}"></i>{{ level_label[level] }}</span>
            <span class="chip">{{ f.source }}:{{ f.check_id }}</span>
            {% for c in f.cwe %}<span class="chip">{{ c }}</span>{% endfor %}
            {% if f.cvss_score %}<span class="chip">CVSS {{ "%.1f"|format(f.cvss_score) }}</span>{% endif %}
            {% if f.is_new %}<span class="chip nuevo">nuevo</span>{% endif %}
          </div>
          <h3>{{ f.title }}</h3>
          <code class="url">{{ f.target }}{% if f.param %}, parámetro {{ f.param }}{% endif %}</code>
          {% if f.description %}<p>{{ f.description }}</p>{% endif %}
          {% if f.remediation %}<p class="fix">{{ f.remediation }}</p>{% endif %}
        </div>
        {% for e in f.evidence %}
          {% if e.request or e.response or e.snippet %}
          <details{% if loop.first and level in ("critical","high") %} open{% endif %}>
            <summary>Evidencia {{ loop.index }}</summary>
            {% if e.request %}<pre>{{ e.request|http }}</pre>{% endif %}
            {% if e.response %}<pre>{{ e.response|http }}</pre>{% endif %}
            {% if e.snippet %}<pre>{{ e.snippet }}</pre>{% endif %}
          </details>
          {% endif %}
        {% endfor %}
      </article>
      {% endfor %}
    {% endif %}
  {% endfor %}

  <footer>
    Generado por Crux {{ version }} el {{ generated }}.<br>
    {% if kind == "code" %}Ruta analizada: <b>{{ scope_text }}</b>. Sin usar la red.{% else %}Alcance: <b>{{ scope_text }}</b>. {{ egress }} durante todo el escaneo.{% endif %}<br>
    Herramientas: <b>{{ tools }}</b>.
  </footer>
</div>
</body>
</html>
